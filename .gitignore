# Generated and downloaded training material
# (anchored to repo root: unanchored "runs/" also matched the small,
# version-controlled results/reference/ablations/*/runs/ ledgers)
/artifacts/
/runs/
/searches/
/checkpoints/
results/experiments/
# Working data should live under the external MethylPredictionData root, not here -- but
# guard against a repeat of the 2026-09-07 foundation-models session, which wrote ~8GB of
# arrow/npy/mmap intermediates to a repo-local derived/ by mistake.
/derived/
*.pt
*.h5
*.hdf5
*.npz
MethylPredictionData/

# Vendored external foundation-model repos + their checkpoints + per-model
# isolated venvs (benchmark/foundation_models/, see docs/PAPER_EXPERIMENTS.md)
external/

# Vendored clone of the MethylProphet repo itself (reference/comparison only,
# has its own nested .git -- never commit as an embedded repo)
MethylProphet/

# Python and test state
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
wandb/

# Runtime logs
*.log
*.nohup.out
logs/

# Build metadata
*.egg-info/

# Local environments and IDE state
.venv/
.idea/
.vscode/
